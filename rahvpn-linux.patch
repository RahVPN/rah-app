+#!/usr/bin/env bash
+# Builds the release bundle and packs it with the Aether core: dist/rahvpn-linux-<arch>.tar.gz
+# Run from the project root after tools/setup_linux.sh.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$ROOT"
+[ -f linux/aether/aether ] || bash tools/fetch_deps_linux.sh
+
+flutter build linux --release
+case "$(uname -m)" in x86_64) A=x64; N=x86_64 ;; aarch64) A=arm64; N=arm64 ;; *) echo "unsupported arch" >&2; exit 1 ;; esac
+BUNDLE="build/linux/$A/release/bundle"
+[ -x "$BUNDLE/rah_app" ] || { echo "$BUNDLE/rah_app not found" >&2; exit 1; }
+
+rm -rf "$BUNDLE/aether"
+cp -R linux/aether "$BUNDLE/aether"      # the app looks for <bundle>/aether/aether
+mkdir -p dist
+OUT="dist/rahvpn-linux-$N.tar.gz"
+tar -czf "$OUT" --transform 's,^bundle,rahvpn,' -C "$(dirname "$BUNDLE")" bundle
+echo "done: $OUT"
+echo "run:  tar xzf $OUT && ./rahvpn/rah_app"
